# ---------- 本機開發（複製成 .env.local，勿提交）----------
# cp .env.example .env.local
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_SCHEDULE_API_URL=http://127.0.0.1:5055

# 切換 Graph（本機多流程；正式 Dockerfile 預設仍是 agent）
# agent | rework_mo_detective | rd_risk_dashboard | qv_dms_pipeline
NEXT_PUBLIC_ASSISTANT_ID=agent

# Optional. Required for Agent Builder deployments.
# Set to "langsmith-api-key" when using a LangSmith PAT.
NEXT_PUBLIC_AUTH_SCHEME=
# Do NOT prefix this with "NEXT_PUBLIC_" as we do not want this exposed in the client.
LANGSMITH_API_KEY=

# ---------- 生產／公司部署提示 ----------
# Dockerfile build 時會寫死 NEXT_PUBLIC_API_URL=/api 與 NEXT_PUBLIC_ASSISTANT_ID=agent。
# 本機請用 .env.local 覆寫；不要改 Dockerfile，除非要晉升多助手到 QAS。
