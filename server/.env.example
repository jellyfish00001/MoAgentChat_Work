# 本機開發用：複製成 .env 再填值（.env 已在 .gitignore，不會進 git，也不會打包進 image）
#   cp .env.example .env
# k8s 上不讀這個檔案，同樣的變數改由 Vault 注入
# 以下 8 個都是必填，少一個 server 啟動時就會報錯並列出缺哪些

# ---------- Azure AD（AAD App Registration 的 Client Credentials）----------
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
# 取 token 用的 scope，通常以 /.default 結尾
AZ_SCOPE=

# ---------- LLM（透過 APIM 呼叫 Luna）----------
AZ_LLM_ENDPOINT=
# Azure OpenAI API 版本，例如 2025-03-01-preview
AZ_LLM_VERSION=
# 模型（deployment）名稱，例如 gpt-6-luna
LLM_MODEL_NAME=
# APIM 訂閱金鑰
OCP_APIM_SUBSCRIPTION_KEY=

# ---------- LangSmith（選填）----------
# 不填也能正常運作；要在 LangSmith 後台看每次對話的 trace（debug 用）才需要
# LANGSMITH_TRACING=true
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
# LANGSMITH_PROJECT=ai_prepare
# LANGCHAIN_PROJECT=ai_prepare

# ---------- 本機業務 graph 測試資料路徑（選填；預設 server/testdata/*）----------
# FLOWS_TESTDATA_ROOT=
# REWORK_MO_DATA=
# RD_RISK_DATA=
# QV_DMS_DATA=
# FLOWS_ANALYSIS_LIMIT=5
# FLOWS_RD_SAMPLE_LIMIT=50

# ---------- Jira MCP ----------
# 亦可設 Windows User 環境變數；勿把真 token 寫進會進 git 的檔
# JIRA_URL=https://swpc.atlassian.net
# JIRA_USERNAME=
# JIRA_API_TOKEN=
