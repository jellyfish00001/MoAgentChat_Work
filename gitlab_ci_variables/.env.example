# 複製成 .env 後填入實際值：cp gitlab_ci_variables/.env.example gitlab_ci_variables/.env
# .env 已加入 .gitignore，不會被 commit

# ===== GitLab（腳本用來連線，不會寫進 CI 變數）=====
GITLAB_URL=https://gitlab.wistron.com
GITLAB_PROJECT=finbi-projects/etl/mo_agentchat
# Personal Access Token，需勾 api 權限；留空的話執行時會問
GITLAB_TOKEN=

# ===== 要寫進 GitLab CI/CD Variables 的值 =====
# Harbor 網址，不要加 https://
HARBOR_URL=harbor.wistron.com
# Harbor 專案名稱
HARBOR_PROJECT=k8sprdwhqfin-ai-agent
# Harbor 帳號（建議之後改成 robot account）
HARBOR_USER=
# Harbor 密碼或 robot token；留空的話執行時會問。名稱含 PASSWORD/TOKEN/SECRET 的變數會自動設成 Masked
HARBOR_PASSWORD=
